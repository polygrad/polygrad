{
  "format": "poly.modeldef@1", "type": "graph", "seed": 7,
  "inputs": {"tokens": {"shape": [{"name":"batch","min":1,"max":3},3], "dtype":"int32"}},
  "nodes": [
    {"name":"embedding","type":"embedding","vocab_size":4,"embed_dim":4,"inputs":["tokens"]},
    {"name":"rms","type":"rmsnorm","inputs":["embedding"]},
    {"name":"split","type":"reshape","shape":[{"name":"batch","min":1,"max":3},3,2,2],"inputs":["rms"]},
    {"name":"heads","type":"permute","axes":[0,2,1,3],"inputs":["split"]},
    {"name":"rotary","type":"rope","theta":10000,"inputs":["heads"]},
    {"name":"attention","type":"attention","is_causal":true,"inputs":["rotary","rotary","rotary"]},
    {"name":"unheads","type":"permute","axes":[0,2,1,3],"inputs":["attention"]},
    {"name":"flatten","type":"reshape","shape":[{"name":"batch","min":1,"max":3},3,4],"inputs":["unheads"]},
    {"name":"norm","type":"layernorm","inputs":["flatten"]},
    {"name":"head","type":"linear","out_features":2,"bias":false,"inputs":["norm"]},
    {"name":"average","type":"mean","inputs":["head"]}
  ],
  "outputs": {"prediction":"head","mean":"average"}
}
